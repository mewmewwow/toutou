    "36d5d54e-ef23-47f4-afca-72f472ae56b0": {
      "id": "36d5d54e-ef23-47f4-afca-72f472ae56b0",
      "message": {
        "id": "36d5d54e-ef23-47f4-afca-72f472ae56b0",
        "author": {
          "role": "assistant",
