            "code": "import difflib\r\n\r\ndef highlight_diff(wrong: str, correct: str):\r\n    \"\"\"\r\n    Compare two words and highlight differences in a way similar to the picture:\r\n    - Red with strikethrough for deleted chars\r\n    - Green for inserted chars\r\n    - White for unchanged chars\r\n    \"\"\"\r\n    seqm = difflib.SequenceMatcher(None, wrong, correct)\r\n    result = []\r\n    for opcode, i1, i2, j1, j2 in seqm.get_opcodes():\r\n        if opcode == 'equal':\r\n            # unchanged → white\r\n            result.append(('white', wrong[i1:i2]))\r\n        elif opcode == 'delete':\r\n            # deleted → red with strikethrough\r\n            result.append(('red_strike', wrong[i1:i2]))\r\n        elif opcode == 'insert':\r\n            # inserted → green\r\n            result.append(('green', correct[j1:j2]))\r\n        elif opcode == 'replace':\r\n            # replace = delete + insert\r\n            result.append(('red_strike', wrong[i1:i2]))\r\n            result.append(('green', correct[j1:j2]))\r\n    return result\r\n\r\n\r\n# Example: percent -> discount\r\ndiff_result = highlight_diff(\"percent\", \"discount\")\r\n\r\ndiff_result",
